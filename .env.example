# ---------------------------------------------------------------------------
# Learners Park — environment configuration
#
# Copy to `.env` for local development. Never commit the real file.
#
# The CSSS and OPAM practice engines run on-device and need no variables.
# The variables under "Server (required for accounts/admin)" are required to
# run the full-stack Node server in production.
# ---------------------------------------------------------------------------

# --- Server (required for accounts/admin in production) --------------------
# MySQL connection string used by Drizzle ORM for student accounts, attempts,
# and admin data.
# DATABASE_URL=mysql://user:password@host:3306/learnerspark

# Secret used to sign session cookies (JWT). Use a long random value.
# Optional: when unset, session cookies (admin/student login) are disabled, but
# the public site and the lead form keep working. Set it to enable login.
# JWT_SECRET=replace-with-a-long-random-secret

# --- Server (optional) ------------------------------------------------------
# OAuth provider used for owner/admin login. When unset, admin OAuth login is
# unavailable but student email/mobile login still works.
# OAUTH_SERVER_URL=https://accounts.example.com
# Client id for the OAuth provider (also used client-side for sign-in).
# VITE_APP_ID=
# openId of the owner account; this user is granted the `admin` role.
# OWNER_OPEN_ID=
# Built-in object storage (used by the /manus-storage proxy).
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Lead-capture form: Google Apps Script Web App URL that appends the lead to a
# Google Sheet and sends the student a confirmation email via GmailApp.
# When unset, the pre-test form still runs but submissions are not delivered.
# LEAD_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Optional shared secret; when set, sent in the request body so the Apps Script
# can reject calls that do not come from this server.
# LEAD_WEBHOOK_SECRET=

# --- Client (build-time, all optional) --------------------------------------
# OAuth portal used by the client for owner/admin "sign in" redirects. When
# unset, the admin sign-in button does not work (the rest of the site is fine).
# VITE_OAUTH_PORTAL_URL=https://accounts.example.com
